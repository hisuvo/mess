# ==========================================
# Application
# ==========================================

PORT=5000
APP_ENV=development


# ==========================================
# Database
# ==========================================

DATABASE_URL="host=localhost user=postgres password=12345 dbname=mess port=5432 sslmode=disable TimeZone=Asia/Shanghai"



# ==========================================
# JWT
# ==========================================

JWT_SECRET="change-this-to-a-long-random-secret-key"
JWT_ISSUER="mess-management-api"
JWT_AUDIENCE="mess-management-client"
JWT_EXPIRES_IN="24h"


# ==========================================
# Platform Owner
# ==========================================

OWNER_EMAIL="owner@mess-management.com"
OWNER_PASSWORD="Owner@123456"
OWNER_NAME="Platform Owner"
Owner_Phone="01571463049"


# ==========================================
# API Security
# ==========================================

API_KEY="http://localhost:5000/api/v1"


# ==========================================
# Cookie
# ==========================================

COOKIE_NAME="refresh_token"
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE="lax"
COOKIE_MAX_AGE=604800