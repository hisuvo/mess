# ==========================================
# Application
# ==========================================

PORT=5000
APP_ENV=development


# ==========================================
# Database
# ==========================================

DATABASE_URL="host=localhost user=postgres password=12345 dbname=messify port=5432 sslmode=disable TimeZone=Asia/Shanghai"



# ==========================================
# JWT
# ==========================================

JWT_SECRET="change-this-to-a-long-random-secret-key"
JWT_ISSUER="mess-management-api"
JWT_AUDIENCE="mess-management-client"
JWT_EXPIRES_IN="24h"


# ==========================================
# Platform Super Admin
# ==========================================

ADMIN_EMAIL="admin@messmanagement.com"
ADMIN_PASSWORD="Admin@123456"
ADMIN_NAME="Platform Admin"


# ==========================================
# API Security
# ==========================================

API_KEY="demo-api-key-change-this"


# ==========================================
# Cookie
# ==========================================

COOKIE_NAME="refresh_token"
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE="lax"
COOKIE_MAX_AGE=604800